# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/imovies
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/imovies?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/imovies

# JWT Secret Key for Token Generation and Verification
JWT_SECRET=imovies_super_secret_jwt_key_2026_secure_token

# Client URL for Cross-Origin Resource Sharing (CORS)
CLIENT_URL=http://localhost:5173

# Default Initial Administrator Credentials (used only by seed script)
ADMIN_INITIAL_NAME=System Administrator
ADMIN_INITIAL_EMAIL=admin@imovies.com
ADMIN_INITIAL_PASSWORD=Admin@123456
